        <span class="hidden md:inline-block text-xs bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700">Schema v2.0 預覽原型</span>
      </div>
      <nav class="flex items-center space-x-2 sm:space-x-6 text-sm font-medium">
        <button onclick="navigate('home')" class="hover:text-amber-400 transition">首頁總覽</button>
        <button onclick="navigate('brands')" class="hover:text-amber-400 transition">依品牌瀏覽</button>
        <button onclick="navigate('category', 'blade')" class="hover:text-amber-400 transition">底板庫</button>
        <button onclick="navigate('category', 'rubber')" class="hover:text-amber-400 transition">膠皮庫</button>
        <button onclick="openCompareModal()" class="bg-slate-800 hover:bg-slate-700 border border-slate-600 px-3 py-1.5 rounded-lg flex items-center space-x-1.5 transition">
          <span>規格對比</span>
          <span id="nav-compare-count" class="bg-amber-500 text-slate-950 font-bold text-xs px-1.5 py-0.2 rounded-full">0</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- 主內容動態渲染區 -->
  <main id="app" class="max-w-7xl w-full mx-auto px-4 sm:px-6 py-8 flex-grow"></main>

  <!-- 底部浮動規格對比列 -->
  <div id="compare-bar" class="hidden fixed bottom-0 inset-x-0 bg-slate-900 text-white border-t border-slate-700 shadow-2xl z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center space-x-3">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400">已選對比項目：</span>
        <div id="compare-chips" class="flex flex-wrap gap-2"></div>
      </div>
      <div class="flex items-center space-x-3">
        <button onclick="clearCompare()" class="text-xs text-slate-400 hover:text-white underline">清空</button>
        <button onclick="openCompareModal()" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm px-4 py-1.5 rounded-lg transition">
          開始並排對照規格 →
        </button>
      </div>
    </div>
  </div>

  <!-- 規格並排對比彈出視窗 (Modal) -->
