        alert("請至少勾選 2 款同類別器材進行並排對照！");
        return;
      }
      const items = state.compareList.map(id => DB.products.find(p => p.id === id));
      const cat = items[0].category;
      const container = document.getElementById("compare-table-container");

      // 定義不同類別要並排比較的客觀欄位
      let rows = [
        { label: "品牌", getValue: p => `${getBrand(p.brand_id).name_en} (${getBrand(p.brand_id).name_zh})` },
        { label: "上市年份", getValue: p => `${p.release_year} 年` },
        { label: "產地", getValue: p => p.specs.made_in || "未標示" }
      ];

      if (cat === "blade") {
        rows.push(
          { label: "打法定位", getValue: p => p.specs.playstyle },
          { label: "結構類型", getValue: p => p.specs.composition },
          { label: "面材 (Surface)", getValue: p => p.specs.wood_layers?.surface || "null" },
          { label: "纖維層 (Fiber)", getValue: p => p.specs.wood_layers?.fiber || "無 (純木)" },
          { label: "大芯 (Core)", getValue: p => p.specs.wood_layers?.core || "null" },
          { label: "板身厚度", getValue: p => `${p.specs.thickness_mm} mm` },
          { label: "拍面尺寸", getValue: p => `${p.specs.head_size_mm.length} × ${p.specs.head_size_mm.width} mm` },
          { label: "官方平均重量", getValue: p => `${p.specs.weight_avg_g} g` },
          { label: "JTTA 認證", getValue: p => p.specs.jtta_approved ? "✔ 已認證" : "無" }
        );
      } else if (cat === "rubber") {
        rows.push(
          { label: "膠皮類型", getValue: p => p.specs.rubber_type_label },
          { label: "膠面性質", getValue: p => p.specs.topsheet_label },
          { label: "海綿結構", getValue: p => p.specs.sponge_type },
          { label: "原廠硬度標準", getValue: p => `${p.specs.hardness_values} (${p.specs.hardness_scale})` },
          { label: "換算 Shore-C 參考", getValue: p => p.specs.equivalent_shore_c },
          { label: "可選厚度 (mm)", getValue: p => p.specs.sponge_thickness_mm.join(" / ") },
          { label: "裁剪後參考重量", getValue: p => `${p.specs.cut_weight_avg_g} g` },
          { label: "ITTF 認證編號", getValue: p => p.specs.ittf_approved_code }
        );
      }

      const tableHtml = `
        <table class="w-full text-sm text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-200">
              <th class="py-3 px-4 bg-slate-100 font-bold text-slate-600 w-44">客觀規格參數</th>
              ${items.map(p => `
                <th class="py-3 px-4 bg-slate-50 font-bold text-slate-900 min-w-[180px]">
                  <div class="text-xs text-amber-600 font-semibold">${getBrand(p.brand_id).name_en}</div>
                  <div class="text-base">${p.name_en}</div>
                  <div class="text-xs text-slate-500 font-normal">${p.name_zh}</div>
                </th>
              `).join("")}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            ${rows.map(row => {
              const vals = items.map(row.getValue);
              const isDifferent = new Set(vals).size > 1;
              return `
                <tr class="${isDifferent ? 'bg-amber-50/70' : ''}">
                  <td class="py-2.5 px-4 font-medium text-slate-600 bg-slate-50/50">${row.label}</td>
                  ${vals.map(v => `<td class="py-2.5 px-4 font-semibold text-slate-800">${v}</td>`).join("")}
                </tr>
              `;
            }).join("")}
          </tbody>
        </table>
      `;
      container.innerHTML = tableHtml;
      document.getElementById("compare-modal").classList.remove("hidden");
    }

    function closeCompareModal() {
      document.getElementById("compare-modal").classList.add("hidden");
    }

    // =========================================================================
    // 輔助工具函式
    // =========================================================================
    function categoryName(cat) {
      const map = {
        blade: "底板 (Blades)",
        rubber: "膠皮 (Rubbers)",
        shoe: "桌球鞋 (Shoes)",
        apparel: "球衣與服飾 (Apparel)",
        ball: "桌球用球 (Balls)"
      };
      return map[cat] || cat;
    }

    function renderProductCard(p) {
      const brand = getBrand(p.brand_id);
      const isCompared = state.compareList.includes(p.id);
      let specBadges = "";

      if (p.category === "blade") {
        specBadges = `
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">${p.specs.composition}</span>
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">面材: ${p.specs.wood_layers.surface.split(" ")[0]}</span>
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">厚 ${p.specs.thickness_mm}mm</span>
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">均重 ${p.specs.weight_avg_g}g</span>
        `;
      } else if (p.category === "rubber") {
        specBadges = `
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">${p.specs.topsheet_label}</span>
          <span class="bg-amber-50 text-amber-800 border border-amber-200 px-2 py-0.5 rounded text-xs font-medium">硬度: ${p.specs.hardness_values} (${p.specs.hardness_scale.split(" ")[0]})</span>
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">換算 Shore-C: ${p.specs.equivalent_shore_c}</span>
        `;
      } else if (p.category === "shoe") {
        specBadges = `
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">楦頭: ${p.specs.width_fit}</span>
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">重量: ${p.specs.weight_g}g (${p.specs.weight_ref})</span>
        `;
      } else if (p.category === "apparel") {
        specBadges = `
          <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded text-xs font-medium">${p.specs.jtta_approved ? "✔ JTTA 認證" : "無 JTTA 標章"}</span>
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">版型: ${p.specs.sizing_standard}</span>
        `;
      } else if (p.category === "ball") {
        specBadges = `
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">${p.specs.star_rating}</span>
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">${p.specs.seam_type}</span>
          <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs font-medium">產地: ${p.specs.made_in}</span>
        `;
      }

      const canCompare = p.category === "blade" || p.category === "rubber";

      return `
        <div onclick="navigate('product-detail', '${p.id}')" class="bg-white border border-slate-200 hover:border-amber-500 rounded-xl p-5 shadow-sm hover:shadow-md transition cursor-pointer flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start gap-2">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-amber-600">${brand.name_en} · ${categoryName(p.category).split(" ")[0]}</span>
                <h3 class="text-lg font-bold text-slate-900 mt-0.5">${p.name_en}</h3>
                <p class="text-sm text-slate-500">${p.name_zh} <span class="text-xs text-slate-400">(${p.release_year})</span></p>
              </div>
              ${canCompare ? `
                <button onclick="toggleCompare('${p.id}', event)" class="text-xs px-2.5 py-1 rounded-lg border font-semibold transition ${isCompared ? 'bg-amber-500 border-amber-500 text-slate-950' : 'bg-white border-slate-300 text-slate-600 hover:border-slate-900'}">
                  ${isCompared ? '✔ 已選對比' : '+ 對比'}
                </button>
              ` : ''}
            </div>
            <div class="mt-4 flex flex-wrap gap-1.5">
              ${specBadges}
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between items-center text-xs text-slate-400">
            <span>俗稱: ${p.aliases.join(" / ")}</span>
            <span class="text-slate-700 font-semibold">查看完整規格 →</span>
          </div>
        </div>
      `;
    }

