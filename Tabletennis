            ${items.length > 0
              ? `<div class="grid grid-cols-1 md:grid-cols-2 gap-5">${items.map(renderProductCard).join("")}</div>`
              : `<div class="bg-white border border-slate-200 rounded-xl p-10 text-center text-slate-400">沒有符合目前篩選條件的器材。</div>`
            }
          </div>
        </div>
      `;
    }

    function renderProductDetail(productId) {
      const p = DB.products.find(item => item.id === productId);
      const brand = getBrand(p.brand_id);
      const isCompared = state.compareList.includes(p.id);
      const canCompare = p.category === "blade" || p.category === "rubber";

      // 自動生成底板木層結構視覺剖面圖 (僅針對底板)
      let bladeDiagramHtml = "";
      if (p.category === "blade" && p.specs.wood_layers) {
        const wl = p.specs.wood_layers;
        const isOuter = p.specs.structure_type === "outer-fiber";
        const topLayers = isOuter
          ? [
              { role: "面材 (Surface)", name: wl.surface, color: "bg-amber-200 border-amber-400 text-amber-950" },
              { role: "纖維層 (Fiber)", name: wl.fiber, color: "bg-sky-200 border-sky-400 text-sky-950 font-bold" },
              { role: "力材 (Medial)", name: wl.medial, color: "bg-amber-100 border-amber-300 text-amber-900" }
            ]
          : [
              { role: "面材 (Surface)", name: wl.surface, color: "bg-amber-200 border-amber-400 text-amber-950" },
              { role: "力材 (Medial)", name: wl.medial, color: "bg-amber-100 border-amber-300 text-amber-900" },
              { role: "纖維層 (Fiber)", name: wl.fiber, color: "bg-sky-200 border-sky-400 text-sky-950 font-bold" }
            ];

        bladeDiagramHtml = `
          <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-1">木層結構橫切面示意圖 (自動生成)</h3>
            <p class="text-xs text-slate-500 mb-4">依據 YAML 定義之 ${p.specs.composition} 對稱結構繪製</p>
            <div class="space-y-1.5 text-xs">
              ${topLayers.map(l => `
                <div class="wood-layer ${l.color} border px-3 py-2 rounded flex justify-between items-center">
                  <span>${l.role}</span>
                  <span>${l.name}</span>
                </div>
              `).join("")}
              <div class="wood-layer bg-orange-200 border border-orange-400 text-orange-950 font-bold px-3 py-3.5 rounded flex justify-between items-center">
                <span>大芯 (Core)</span>
                <span>${wl.core}</span>
              </div>
              ${[...topLayers].reverse().map(l => `
                <div class="wood-layer ${l.color} border px-3 py-2 rounded flex justify-between items-center opacity-85">
                  <span>${l.role}</span>
                  <span>${l.name}</span>
                </div>
              `).join("")}
            </div>
          </div>
        `;
      }

      // 動態組裝客觀參數表
      let specRows = [
        ["所屬品牌", `<span class="text-amber-600 font-bold cursor-pointer underline" onclick="navigate('brand-detail', '${brand.id}')">${brand.name_en} (${brand.name_zh})</span>`],
        ["產品系列", p.series],
        ["上市年份", `${p.release_year} 年`],
        ["販售狀態", p.status === "active" ? "● 現售中 (Active)" : "○ 已停產 (Discontinued)"],
        ["製造產地", p.specs.made_in || "null"]
      ];

      if (p.category === "blade") {
        specRows.push(
          ["打法定位", p.specs.playstyle],
          ["層數與結構", `${p.specs.plies_count} 層 — ${p.specs.composition}`],
          ["官方公稱厚度", `${p.specs.thickness_mm} mm`],
          ["拍面尺寸", `${p.specs.head_size_mm.length} × ${p.specs.head_size_mm.width} mm`],
          ["官方平均重量", `${p.specs.weight_avg_g} g`],
          ["JTTA 認證", p.specs.jtta_approved ? "✔ 已通過認證" : "無"],
          ["握柄規格尺寸", p.specs.handle_types.map(h => `<b>${h.code}</b>: 長${h.length_mm} × 厚${h.thickness_mm} × 尾寬${h.width_end_mm}mm`).join("<br/>")]
        );
      } else if (p.category === "rubber") {
        specRows.push(
          ["膠皮類型", p.specs.rubber_type_label],
          ["膠面物理特性", p.specs.topsheet_label],
          ["海綿結構與顏色", `${p.specs.sponge_type} (${p.specs.sponge_colors.join(", ")})`],
          ["原廠硬度標示", `<b>${p.specs.hardness_values}</b> (${p.specs.hardness_scale})`],
          ["換算 Shore-C 刻度", `<span class="bg-amber-100 text-amber-900 px-2 py-0.5 rounded font-bold">${p.specs.equivalent_shore_c}</span>`],
          ["可選海綿厚度", `${p.specs.sponge_thickness_mm.join(" / ")} mm`],
          ["裁剪後參考重量", `${p.specs.cut_weight_avg_g} g (157×150mm 基準)`],
          ["ITTF 認證編號", p.specs.ittf_approved_code]
        );
      } else if (p.category === "shoe") {
        specRows.push(
          ["單腳參考重量", `${p.specs.weight_g} g (${p.specs.weight_ref})`],
          ["楦頭寬度規格", p.specs.width_fit],
          ["大底材質", p.specs.outsole_type],
          ["中底緩震科技", p.specs.cushion_tech],
          ["販售尺碼區間", p.specs.size_range_cm]
        );
      } else if (p.category === "apparel") {
        specRows.push(
          ["服飾類別", p.specs.apparel_type],
          ["JTTA 比賽認證", p.specs.jtta_approved ? "✔ 具備 JTTA 認證標章" : "無"],
          ["版型系統", p.specs.sizing_standard],
          ["布料材質", p.specs.material],
          ["市售顏色", p.specs.available_colors.join(", ")]
        );
      } else if (p.category === "ball") {
        specRows.push(
          ["星級認證", p.specs.star_rating],
          ["接縫工藝", p.specs.seam_type],
          ["球體材質", p.specs.material],
          ["標準直徑", p.specs.diameter_mm]
        );
      }

      return `
        <div class="mb-6 flex items-center space-x-2 text-sm text-slate-500">
          <button onclick="navigate('home')" class="hover:text-slate-900">首頁</button>
          <span>/</span>
          <button onclick="navigate('category', '${p.category}')" class="hover:text-slate-900">${categoryName(p.category)}</button>
          <span>/</span>
          <span class="text-slate-900 font-semibold">${p.name_en}</span>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm mb-6">
          <div class="flex flex-wrap justify-between items-start gap-4">
            <div>
              <span class="text-xs font-bold text-amber-600 uppercase tracking-wider">${brand.name_en} · ${categoryName(p.category)}</span>
              <h1 class="text-3xl font-extrabold text-slate-900 mt-1">${p.name_en} <span class="text-xl font-normal text-slate-500">(${p.name_zh})</span></h1>
              <p class="text-xs text-slate-400 mt-1">別名與型號代碼：${p.aliases.join("、")}</p>
            </div>
            ${canCompare ? `
              <button onclick="toggleCompare('${p.id}')" class="px-4 py-2 rounded-xl font-bold text-sm border transition ${isCompared ? 'bg-amber-500 border-amber-500 text-slate-950' : 'bg-slate-900 text-white hover:bg-slate-800'}">
                ${isCompared ? '✔ 已加入對比清單' : '+ 加入規格對比'}
              </button>
            ` : ''}
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="${bladeDiagramHtml ? 'lg:col-span-2' : 'lg:col-span-3'} bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
            <div class="px-6 py-4 bg-slate-900 text-white font-bold text-sm">官方客觀硬規格參數表 (Objective Specifications)</div>
            <table class="w-full text-sm">
              <tbody class="divide-y divide-slate-200">
                ${specRows.map(([k, v]) => `
                  <tr>
                    <td class="py-3 px-6 bg-slate-50 font-medium text-slate-600 w-1/3">${k}</td>
                    <td class="py-3 px-6 text-slate-900 font-medium">${v}</td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>

          ${bladeDiagramHtml}
        </div>

        <div class="mt-6 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-2">結構與工藝客觀備註 (來自 Markdown 內文)</h3>
          <p class="text-sm text-slate-700 leading-relaxed">${p.notes}</p>
        </div>
      `;
    }

    function render() {
      const app = document.getElementById("app");
      if (state.view === "home") app.innerHTML = renderHome();
      else if (state.view === "brands") app.innerHTML = renderBrandsList();
      else if (state.view === "brand-detail") app.innerHTML = renderBrandDetail(state.param);
      else if (state.view === "category") app.innerHTML = renderCategory(state.param);
      else if (state.view === "product-detail") app.innerHTML = renderProductDetail(state.param);
    }

    // 啟動渲染
    render();
  </script>
</body>
</html>
