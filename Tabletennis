    let state = {
      view: "home",        // home | brands | brand-detail | category | product-detail
      param: null,
      searchQuery: "",
      compareList: [],     // 存放 product.id
      filters: {
        brand: "all",
        bladeStructure: "all",
        rubberSurface: "all"
      }
    };

    function getBrand(brandId) {
      return DB.brands.find(b => b.id === brandId) || { name_en: brandId, name_zh: "" };
    }

    function navigate(view, param = null) {
      state.view = view;
      state.param = param;
      // 切換類別時重置子篩選
      if (view === "category") {
        state.filters = { brand: "all", bladeStructure: "all", rubberSurface: "all" };
      }
      window.scrollTo({ top: 0, behavior: "smooth" });
      render();
    }

    // =========================================================================
    // 對比車功能 (Compare Drawer)
    // =========================================================================
    function toggleCompare(productId, event) {
      if (event) event.stopPropagation();
      const idx = state.compareList.indexOf(productId);
      if (idx > -1) {
        state.compareList.splice(idx, 1);
      } else {
        if (state.compareList.length >= 4) {
          alert("最多同時並排對比 4 項器材！");
          return;
        }
        // 檢查是否為同類別（不同類別硬規格欄位不同）
        if (state.compareList.length > 0) {
          const firstItem = DB.products.find(p => p.id === state.compareList[0]);
          const currentItem = DB.products.find(p => p.id === productId);
          if (firstItem.category !== currentItem.category) {
            alert(`請選擇相同類別進行對比（目前對比車內為「${categoryName(firstItem.category)}」）。`);
            return;
          }
        }
        state.compareList.push(productId);
      }
      updateCompareBar();
      render();
    }

    function clearCompare() {
      state.compareList = [];
      updateCompareBar();
      render();
    }

    function updateCompareBar() {
      const bar = document.getElementById("compare-bar");
      const countBadge = document.getElementById("nav-compare-count");
      const chips = document.getElementById("compare-chips");
      countBadge.textContent = state.compareList.length;

      if (state.compareList.length === 0) {
        bar.classList.add("hidden");
        return;
      }
      bar.classList.remove("hidden");
      chips.innerHTML = state.compareList.map(id => {
        const p = DB.products.find(item => item.id === id);
        return `
          <span class="bg-slate-800 border border-slate-600 text-xs px-2.5 py-1 rounded-full flex items-center space-x-1.5">
            <span>${p.name_en}</span>
            <button onclick="toggleCompare('${id}')" class="text-slate-400 hover:text-amber-400 font-bold">&times;</button>
          </span>
        `;
      }).join("");
    }

    function openCompareModal() {
